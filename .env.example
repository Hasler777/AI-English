# Ключ OpenAI для озвучки (TTS). Без него озвучка идёт голосом браузера.
OPENAI_API_KEY=
# Свой endpoint (прокси/агрегатор, OpenAI-совместимый), если api.openai.com недоступен
# OPENAI_BASE_URL=https://api.openai.com/v1
# TTS_MODEL=gpt-4o-mini-tts
# TTS_VOICE=alloy
# 0.0.0.0 — чтобы открыть с телефона в той же Wi-Fi сети. Тогда обязателен ACCESS_TOKEN
# (openssl rand -hex 16); с телефона один раз открыть http://<ip>:3001/?token=<токен>
# HOST=127.0.0.1
# ACCESS_TOKEN=
# Доменные имена, под которыми открывается сервер (IP и localhost разрешены всегда)
# ALLOWED_HOSTS=
# API_PORT=3001
